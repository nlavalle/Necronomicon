<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildProjectDirectory)../configuration/$(Configuration)/**/*.cs" />
  </ItemGroup>
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionBasis>1/1/2026</VersionBasis>
    <VersionSuffix>alpha$([MSBuild]::Divide($([MSBuild]::Subtract($([System.DateTime]::Now.Ticks), $([System.DateTime]::Parse($(VersionBasis)).Ticks))), $([System.TimeSpan]::FromMinutes(1).Ticks)).ToString("D7"))</VersionSuffix>
    <AssemblyName>Necronomicon.$(MSBuildProjectName)</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup Condition=" '$(Configuration)' == 'Debug' ">
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>$(MSBuildProjectName).Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
